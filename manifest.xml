<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  
  <!-- Updated with a fresh GUID -->
  <Id>d142b5a1-7e78-4389-913a-75b2de34ab9e</Id>
  <Version>1.0.0.2</Version>
  <ProviderName>Onassis</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Word Count Reminder" />
  <Description DefaultValue="Automatically displays a brevity reminder when composing emails." />
  
  <IconUrl DefaultValue="https://pancyber.github.io/onassis_outlook_app/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://pancyber.github.io/onassis_outlook_app/icon-128.png" />
  <SupportUrl DefaultValue="https://pancyber.github.io/onassis_outlook_app/" />

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10" />
    </Sets>
  </Requirements>

  <!-- MANDATORY SCHEMA FALLBACKS -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://pancyber.github.io/onassis_outlook_app/autorun.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  
  <Permissions>ReadWriteItem</Permissions>
  
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <!-- END MANDATORY FALLBACKS -->

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="showPersistentBanner" />
                <LaunchEvent Type="OnReplyCompose" FunctionName="showPersistentBanner" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://pancyber.github.io/onassis_outlook_app/autorun.html" />
          <bt:Url id="JSRuntime.Url" DefaultValue="https://pancyber.github.io/onassis_outlook_app/autorun.js" />
        </bt:Urls>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
```</Rule></FormSettings>
